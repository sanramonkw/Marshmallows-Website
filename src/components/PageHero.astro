---
/** Page title banner — mirrors the live theme's .section-page block. */
interface Props {
  title: string;
  subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="bg-pink py-14 text-center">
  <div class="mx-auto max-w-4xl px-4">
    <h1 class="text-4xl text-white md:text-5xl">{title}</h1>
    {subtitle && <p class="mt-3 text-xl text-pink-pale">{subtitle}</p>}
  </div>
</section>
