---
import type { Locale } from '../i18n/ui';
import { useTranslations, alternatePath, type PageId } from '../i18n/utils';

interface Props {
  locale: Locale;
  page: PageId;
  class?: string;
}

const { locale, page, class: className = '' } = Astro.props;
const t = useTranslations(locale);
const target = alternatePath(page, locale);
const targetLang = locale === 'ar' ? 'en' : 'ar';
---

<a
  href={target}
  lang={targetLang}
  hreflang={targetLang}
  class={`font-bold hover:text-pink transition-colors ${className}`}
>
  {t('nav.langSwitch')}
</a>
