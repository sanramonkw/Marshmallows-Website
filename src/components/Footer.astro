---
import type { Locale } from '../i18n/ui';
import { business } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { withBase } from '../utils/paths';
import BookingCTA from './BookingCTA.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const branchStickers = [
  'sticker--pink sticker--tilt-1',
  'sticker--pale sticker--tilt-2',
  'sticker--pale sticker--tilt-3',
];

// Inline brand icons (currentColor), used for the footer social buttons.
const socialIcons: Record<string, string> = {
  instagram:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2.5" y="2.5" width="19" height="19" rx="5" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="2"/><circle cx="17.4" cy="6.6" r="1.3" fill="currentColor"/></svg>',
  tiktok:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 2h-3v13.1a2.6 2.6 0 1 1-2.2-2.6v-3a5.6 5.6 0 1 0 5.2 5.6V8.9c1 .8 2.3 1.2 3.7 1.3V7.2c-2 0-3.5-1.6-3.7-3.6V2z"/></svg>',
  whatsapp:
    '<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a9.9 9.9 0 0 0-8.5 15.1L2 22l5-1.5A9.9 9.9 0 1 0 12 2zm0 18.1c-1.5 0-2.9-.4-4.1-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.1 8.1 0 1 1 12 20.1zm4.5-6.1c-.2-.1-1.4-.7-1.7-.8-.2-.1-.4-.1-.5.1-.2.3-.6.8-.7 1-.1.1-.3.1-.5 0a6.6 6.6 0 0 1-3.3-2.8c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.8-2c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.9.9-.9 2.2 0 3.6a9.3 9.3 0 0 0 3.7 3.3c1.5.6 2.1.6 2.8.5.5-.1 1.4-.6 1.6-1.1.2-.5.2-1 .1-1.1z"/></svg>',
};

const socialGroups = [
  {
    label: 'Marshmallows',
    links: [
      { icon: 'instagram', href: business.instagram, name: 'Instagram' },
      { icon: 'tiktok', href: business.tiktok, name: 'TikTok' },
      { icon: 'whatsapp', href: business.whatsapp, name: 'WhatsApp' },
    ],
  },
  {
    label: 'Sugar Coat',
    links: [
      { icon: 'instagram', href: business.sugarcoatInstagram, name: 'Instagram' },
      { icon: 'tiktok', href: business.sugarcoatTiktok, name: 'TikTok' },
      { icon: 'whatsapp', href: business.whatsapp, name: 'WhatsApp' },
    ],
  },
];
---

<!-- BOLD variant: deep-plum footer card (ink derivative of the brand pink) -->
<footer class="px-4 pb-8 pt-6 text-sm">
  <div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] border-2 border-plum bg-plum px-6 py-10 text-pink-pale shadow-[0_8px_0_0_var(--color-pink)] md:px-10">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="flex items-center">
        <img src={withBase('/images/mm-logo.png')} alt="Marshmallows Nail Spa" width="220" class="w-44 max-w-full" />
      </div>
      {business.branches.map((b, i) => (
        <div>
          <h3 class="mb-4"><span class={`sticker ${branchStickers[i % branchStickers.length]}`}>{t(b.labelKey)}</span></h3>
          <p class="leading-relaxed text-white">
            {b.lines.map((l) => <>{l}<br /></>)}
            <span dir="ltr">☎ +965 2220 9072</span><br />
            <a href={b.mapUrl} class="font-bold text-pink-light underline underline-offset-4 hover:text-white" rel="noopener" target="_blank">{t('footer.findOnGoogle')}</a>
          </p>
        </div>
      ))}
    </div>

    <!-- Get in touch band, full-width below the branches -->
    <div class="mt-10 flex flex-col gap-8 border-t-2 border-pink-deep/50 pt-8 md:flex-row md:items-end md:justify-between">
      <div class="flex flex-wrap items-end gap-x-10 gap-y-6">
        <div>
          <h3 class="mb-3"><span class="sticker sticker--pale sticker--tilt-3">{t('footer.getInTouch')}</span></h3>
          <a href={`mailto:${business.email}`} class="font-bold text-pink-light underline underline-offset-4 hover:text-white">{business.email}</a>
        </div>
        {socialGroups.map((g) => (
          <div>
            <p class="mb-2 font-bold text-white">{g.label}</p>
            <div class="flex items-center gap-2.5">
              {g.links.map((l) => (
                <a
                  href={l.href}
                  rel="noopener nofollow"
                  target="_blank"
                  aria-label={`${g.label} ${l.name}`}
                  title={`${g.label} ${l.name}`}
                  class="grid h-9 w-9 place-items-center rounded-full bg-pink-light text-plum transition-transform hover:scale-110"
                >
                  <Fragment set:html={socialIcons[l.icon]} />
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
      <BookingCTA locale={locale} />
    </div>

    <div class="mt-10 border-t-2 border-pink-deep/60 pt-6 text-center text-pink-pale/90">
      <p>{t('footer.rights')}</p>
    </div>
  </div>
</footer>
