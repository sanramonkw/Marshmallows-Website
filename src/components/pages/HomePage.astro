---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import type { Locale } from '../../i18n/ui';
import { ui } from '../../i18n/ui';
import { useTranslations, pathFor } from '../../i18n/utils';
import { aboutIntro } from '../../data/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  page="home"
  title={ui[locale]['site.name']}
  description={ui[locale]['site.description']}
>
  <!-- Hero: headline + autoplay video over the theme's leaf-pattern texture -->
  <section class="bg-pink bg-[url(/images/pattern2b.png)] bg-no-repeat bg-right-top py-16">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 md:grid-cols-2">
      <h1 class="text-4xl leading-snug text-white md:text-5xl">{t('home.heroTitle')}</h1>
      <video autoplay muted loop playsinline class="w-full rounded-2xl shadow-lg" aria-hidden="true">
        <source src="/videos/Marshmallows_video_21042026.mov" type="video/mp4" />
      </video>
    </div>
  </section>

  <!-- About Marshmallows: pale card on the pink body background -->
  <section class="py-16">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 md:grid-cols-12">
      <div class="md:col-span-5">
        <img src="/images/IMG_2921.jpg" alt={t('home.aboutTitle')} loading="lazy" class="w-full rounded-2xl shadow-lg" />
      </div>
      <div class="rounded-2xl bg-pink-card p-8 shadow-sm md:col-span-7 md:p-12">
        <h2 class="text-3xl text-pink">{t('home.aboutTitle')}</h2>
        <div class="brand-line my-4 ms-0"></div>
        {aboutIntro[locale].map((p) => <p class="mb-4 text-lg leading-relaxed">{p}</p>)}
        <BookingCTA locale={locale} class="mt-2" />
      </div>
    </div>
  </section>

  <!-- Our Services: white heading directly on the pink-light body, as on the live site -->
  <section class="py-16">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="text-center text-3xl text-white">{t('home.servicesTitle')}</h2>
      <div class="brand-line brand-line--white my-4"></div>
      <div class="mt-10 grid gap-8 sm:grid-cols-3">
        <ServiceCard
          href={pathFor('salonService', locale)}
          image="/images/IMG_4385-e1776769490159.jpg"
          title={t('nav.salonService')}
        />
        <ServiceCard
          href={pathFor('partyBooth', locale)}
          image="/images/IMG_2922.jpg"
          title={t('nav.partyBooth')}
        />
        <ServiceCard
          href={pathFor('homeService', locale)}
          image="/images/WhatsApp-Image-2024-01-25-at-12.57.09-PM.webp"
          title={t('nav.homeService')}
        />
      </div>
    </div>
  </section>
</BaseLayout>
