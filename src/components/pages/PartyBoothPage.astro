---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PartyPackages from '../../components/PartyPackages.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import type { Locale } from '../../i18n/ui';
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { partyPackages } from '../../data/party';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  page="partyBooth"
  title={`${t('nav.partyBooth')} - ${ui[locale]['site.name']}`}
  description={ui[locale]['site.description']}
>
  <PageHero title={t('nav.partyBooth')} />
  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4">
      <PartyPackages locale={locale} packages={partyPackages[locale]} />
      <div class="mt-10 text-center">
        <BookingCTA locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
