---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PriceList from '../../components/PriceList.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import type { Locale } from '../../i18n/ui';
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { homeService } from '../../data/services';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  page="homeService"
  title={`${t('nav.homeService')} - ${ui[locale]['site.name']}`}
  description={ui[locale]['site.description']}
>
  <PageHero title={t('nav.homeService')} />
  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4">
      <PriceList categories={homeService[locale]} />
      <div class="mt-10 text-center">
        <BookingCTA locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
