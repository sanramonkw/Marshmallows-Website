---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import type { Locale } from '../../i18n/ui';
import { ui, business } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { withBase } from '../../utils/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  page="videos"
  title={`${t('nav.videos')} - ${ui[locale]['site.name']}`}
  description={ui[locale]['site.description']}
>
  <PageHero title={t('nav.videos')} />
  <section class="py-14">
    <div class="mx-auto max-w-4xl space-y-10 px-4">
      <video controls playsinline preload="metadata" class="w-full rounded-2xl shadow-lg">
        <source src={withBase('/videos/Marshmallows-Nails-Spa.mp4')} type="video/mp4" />
      </video>
      <video controls playsinline preload="metadata" class="w-full rounded-2xl shadow-lg">
        <source src={withBase('/videos/Marshmallows_video_21042026.mov')} type="video/mp4" />
      </video>
      <p class="text-center text-lg">
        <a href={business.instagram} rel="noopener" target="_blank" class="font-bold text-pink underline">
          {t('videos.followInstagram')}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
