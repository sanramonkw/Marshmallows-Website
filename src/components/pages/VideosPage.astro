---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import type { Locale } from '../../i18n/ui';
import { ui, business } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { withBase } from '../../utils/paths';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  page="videos"
  title={`${t('nav.videos')} - ${ui[locale]['site.name']}`}
  description={ui[locale]['site.description']}
>
  <PageHero title={t('nav.videos')} />
  <section class="py-14">
    <div class="mx-auto max-w-4xl space-y-10 px-4">
      <div class="card-pop tilt-b overflow-hidden p-2" data-reveal>
        <div class="flex max-h-[560px] items-center justify-center rounded-2xl bg-pink-pale">
          <video muted autoplay loop playsinline preload="metadata" class="h-full w-full rounded-2xl object-contain">
            <source src={withBase('/videos/Marshmallows_video_21042026.mov')} type="video/mp4" />
          </video>
        </div>
      </div>
      <div class="card-pop tilt-c overflow-hidden p-2" data-reveal>
        <div class="flex h-[60vh] max-h-[560px] items-center justify-center rounded-2xl bg-pink-pale">
          <video muted autoplay loop playsinline preload="metadata" class="h-full w-full rounded-2xl object-contain">
            <source src={withBase('/videos/IMG_1841.mp4')} type="video/mp4" />
          </video>
        </div>
      </div>
      <p class="text-center text-lg">
        <a href={business.instagram} rel="noopener" target="_blank" class="font-bold text-pink-deep underline underline-offset-4 hover:text-plum">
          {t('videos.followInstagram')}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
