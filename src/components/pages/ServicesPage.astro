---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import type { Locale } from '../../i18n/ui';
import { ui } from '../../i18n/ui';
import { useTranslations, pathFor } from '../../i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  page="services"
  title={`${t('nav.services')} - ${ui[locale]['site.name']}`}
  description={ui[locale]['site.description']}
>
  <PageHero title={t('nav.services')} subtitle={t('services.subtitle')} />

  <section class="grad-soft py-16 md:py-20">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:grid-cols-3">
      <div data-reveal>
        <ServiceCard
          href={pathFor('salonService', locale)}
          image="/images/IMG_4385-e1776769490159.jpg"
          title={t('nav.salonService')}
          tilt="a"
        />
      </div>
      <div data-reveal>
        <ServiceCard
          href={pathFor('partyBooth', locale)}
          image="/images/IMG_2922.jpg"
          title={t('nav.partyBooth')}
          tilt="c"
        />
      </div>
      <div data-reveal>
        <ServiceCard
          href={pathFor('homeService', locale)}
          image="/images/IMG_4401.jpg"
          title={t('nav.homeService')}
          tilt="b"
        />
      </div>
    </div>
  </section>
</BaseLayout>
