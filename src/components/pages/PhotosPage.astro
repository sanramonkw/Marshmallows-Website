---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import type { Locale } from '../../i18n/ui';
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { galleryImages } from '../../data/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const images = galleryImages.map((src, i) => ({
  src,
  alt: `${t('site.name')} — ${t('nav.photos')} ${i + 1}`,
}));
---

<BaseLayout
  locale={locale}
  page="photos"
  title={`${t('nav.photos')} - ${ui[locale]['site.name']}`}
  description={ui[locale]['site.description']}
>
  <PageHero title={t('nav.photos')} />
  <section class="py-14">
    <div class="mx-auto max-w-7xl px-4">
      <GalleryGrid images={images} />
    </div>
  </section>
</BaseLayout>
