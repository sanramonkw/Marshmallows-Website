---
import type { Locale } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import type { PartyPackage } from '../data/party';

interface Props {
  locale: Locale;
  packages: PartyPackage[];
}

const { locale, packages } = Astro.props;
const t = useTranslations(locale);
---

<div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">
  {packages.map((pkg) => (
    <article class="flex flex-col rounded-2xl bg-white p-6 shadow-md">
      <h3 class="mb-3 text-lg text-pink">{pkg.name}</h3>
      <p class="mb-2 font-bold">{pkg.features.join(' • ')}</p>
      {pkg.suitable && <p class="mb-3 text-sm text-neutral-600">{pkg.suitable}</p>}
      <div class="mb-3 space-y-1">
        {pkg.prices.map((p) => <p class="text-2xl font-bold text-ink">{p}</p>)}
      </div>
      {pkg.extras.length > 0 && (
        <ul class="mb-3 space-y-1 text-sm text-neutral-600">
          {pkg.extras.map((e) => (
            <li>
              {e.name && <em>{e.name}: </em>}
              <span class="font-bold">{e.price}</span>
            </li>
          ))}
        </ul>
      )}
      {pkg.note && (
        <p class="mt-auto border-t border-pink-pale pt-3 text-sm italic text-neutral-500">
          {t('party.note')}: {pkg.note}
        </p>
      )}
    </article>
  ))}
</div>
