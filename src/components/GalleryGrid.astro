---
import { withBase } from '../utils/paths';

interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
---

<div class="columns-2 gap-4 md:columns-3 lg:columns-4 [&>a]:mb-4 [&>a]:block">
  {images.map((img) => (
    <a href={withBase(img.src)} target="_blank" rel="noopener" class="overflow-hidden rounded-xl">
      <img
        src={withBase(img.src)}
        alt={img.alt}
        loading="lazy"
        class="w-full rounded-xl shadow-md transition-transform duration-300 hover:scale-[1.02]"
      />
    </a>
  ))}
</div>
