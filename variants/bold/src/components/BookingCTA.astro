---
/**
 * Booking call-to-action — BOLD variant: sticker-energy pill.
 *
 * Links to the booking page, which hosts the native Salonist booking widget
 * (PHASE 2 — see BookingWidget.astro and the PHASE 2 section of CLAUDE.md)
 * with a permanent WhatsApp/phone fallback.
 */
import type { Locale } from '../i18n/ui';
import { useTranslations, pathFor } from '../i18n/utils';

interface Props {
  locale: Locale;
  class?: string;
  size?: 'md' | 'lg';
}

const { locale, class: className = '', size = 'md' } = Astro.props;
const t = useTranslations(locale);
const sizing = size === 'lg' ? 'px-10 py-4 text-xl' : 'px-7 py-2.5';
---

<a
  href={pathFor('booking', locale)}
  class={`group inline-flex items-center gap-2 rounded-full border-2 border-white/40 bg-pink-deep font-bold text-white shadow-[0_4px_0_0_var(--color-plum)] transition-[transform,box-shadow] hover:-translate-y-0.5 hover:shadow-[0_7px_0_0_var(--color-pink)] motion-reduce:transition-none motion-reduce:hover:translate-y-0 ${sizing} ${className}`}
>
  <span aria-hidden="true" class="text-pink-pale">✦</span>
  {t('cta.book')}
</a>
