---
/**
 * Page title banner — BOLD variant: coral→blush gradient field with an
 * oversized display headline in the plum ink derivative (AA on all stops)
 * and an optional sticker-badge subtitle.
 */
interface Props {
  title: string;
  subtitle?: string;
  badge?: string;
}

const { title, subtitle, badge } = Astro.props;
---

<section class="grad-hero relative overflow-hidden border-b-2 border-plum py-16 md:py-20">
  <span aria-hidden="true" class="pointer-events-none absolute -top-8 -end-8 h-40 w-40 rounded-full border-2 border-plum/20 bg-white/30"></span>
  <span aria-hidden="true" class="pointer-events-none absolute -bottom-14 start-[12%] h-28 w-28 rounded-full border-2 border-plum/15 bg-pink/25"></span>
  <div class="relative mx-auto max-w-5xl px-4 text-center">
    {badge && <span class="sticker sticker--tilt-1 mb-5">{badge}</span>}
    <h1 class="display-xl text-plum">{title}</h1>
    {subtitle && <p class="mt-4"><span class="sticker sticker--pale sticker--tilt-2 text-base">{subtitle}</span></p>}
  </div>
</section>
