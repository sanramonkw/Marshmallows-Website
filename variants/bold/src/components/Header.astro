---
import type { Locale } from '../i18n/ui';
import { withBase } from '../utils/paths';
import { useTranslations, pathFor, type PageId } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';
import BookingCTA from './BookingCTA.astro';

interface Props {
  locale: Locale;
  page: PageId;
}

const { locale, page } = Astro.props;
const t = useTranslations(locale);

const servicesChildren: { id: PageId; label: string }[] = [
  { id: 'salonService', label: t('nav.salonService') },
  { id: 'partyBooth', label: t('nav.partyBooth') },
  { id: 'homeService', label: t('nav.homeService') },
];
const galleryChildren: { id: PageId; label: string }[] = [
  { id: 'photos', label: t('nav.photos') },
  { id: 'videos', label: t('nav.videos') },
];

const linkBase = 'rounded-full px-4 py-1.5 transition-colors hover:bg-pink-pale';
const active = 'bg-plum text-white hover:bg-plum';
---

<header class="sticky top-0 z-50 border-b-2 border-plum bg-cream/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-3">
    <a href={pathFor('home', locale)} class="shrink-0" title={t('site.name')}>
      <img src={withBase('/images/mm-logo.png')} alt={t('site.name')} class="h-12 w-auto md:h-14" width="240" height="112" />
    </a>

    <nav class="hidden flex-1 items-center justify-center gap-1 font-bold text-plum lg:flex">
      <a href={pathFor('home', locale)} class:list={[linkBase, { [active]: page === 'home' }]}>{t('nav.home')}</a>

      <div class="relative group">
        <a
          href={pathFor('services', locale)}
          class:list={[linkBase, { [active]: ['services', 'salonService', 'partyBooth', 'homeService'].includes(page) }]}
        >
          {t('nav.services')} ▾
        </a>
        <div class="invisible absolute start-0 top-full pt-3 opacity-0 transition-all group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <ul class="min-w-48 rounded-2xl border-2 border-plum bg-white p-2 shadow-[0_5px_0_0_var(--color-plum)]">
            {servicesChildren.map((c) => (
              <li><a href={pathFor(c.id, locale)} class="block rounded-xl px-3 py-2 hover:bg-pink-pale">{c.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <a href={pathFor('about', locale)} class:list={[linkBase, { [active]: page === 'about' }]}>{t('nav.about')}</a>

      <div class="relative group">
        <a
          href={pathFor('photos', locale)}
          class:list={[linkBase, { [active]: ['photos', 'videos'].includes(page) }]}
        >{t('nav.gallery')} ▾</a>
        <div class="invisible absolute start-0 top-full pt-3 opacity-0 transition-all group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
          <ul class="min-w-48 rounded-2xl border-2 border-plum bg-white p-2 shadow-[0_5px_0_0_var(--color-plum)]">
            {galleryChildren.map((c) => (
              <li><a href={pathFor(c.id, locale)} class="block rounded-xl px-3 py-2 hover:bg-pink-pale">{c.label}</a></li>
            ))}
          </ul>
        </div>
      </div>

      <a href={pathFor('contact', locale)} class:list={[linkBase, { [active]: page === 'contact' }]}>{t('nav.contact')}</a>
      <LanguageSwitcher locale={locale} page={page} class="ms-2 rounded-full border-2 border-plum px-4 py-1" />
    </nav>

    <div class="ms-auto hidden lg:block">
      <BookingCTA locale={locale} />
    </div>

    <!-- mobile toggle -->
    <button
      id="mobile-nav-toggle"
      class="ms-auto rounded-xl border-2 border-plum bg-white px-3 py-1 text-2xl leading-none shadow-[0_3px_0_0_var(--color-plum)] lg:hidden"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >☰</button>
  </div>

  <!-- mobile nav -->
  <div id="mobile-nav" class="hidden border-t-2 border-plum bg-cream px-6 py-5 lg:hidden">
    <ul class="space-y-4 text-lg font-bold text-plum">
      <li><a href={pathFor('home', locale)}>{t('nav.home')}</a></li>
      <li>
        <a href={pathFor('services', locale)}>{t('nav.services')}</a>
        <ul class="ms-4 mt-2 space-y-2 text-base font-normal">
          {servicesChildren.map((c) => <li><a href={pathFor(c.id, locale)}>{c.label}</a></li>)}
        </ul>
      </li>
      <li><a href={pathFor('about', locale)}>{t('nav.about')}</a></li>
      <li>
        <span>{t('nav.gallery')}</span>
        <ul class="ms-4 mt-2 space-y-2 text-base font-normal">
          {galleryChildren.map((c) => <li><a href={pathFor(c.id, locale)}>{c.label}</a></li>)}
        </ul>
      </li>
      <li><a href={pathFor('contact', locale)}>{t('nav.contact')}</a></li>
      <li><LanguageSwitcher locale={locale} page={page} class="inline-block rounded-full border-2 border-plum px-4 py-1" /></li>
      <li><BookingCTA locale={locale} /></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
