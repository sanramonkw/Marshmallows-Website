---
/**
 * Editorial title block — replaces the old pink banner. A numbered
 * eyebrow (Arabic-Indic in AR), a huge quiet headline on paper, and a
 * hairline rule. `num` is the section folio (e.g. "٠٢" / "02").
 */
interface Props {
  title: string;
  subtitle?: string;
  num?: string;
}

const { title, subtitle, num } = Astro.props;
---

<section class="border-b border-hairline">
  <div class="mx-auto max-w-6xl px-5 pb-12 pt-16 lg:px-8 lg:pb-16 lg:pt-24">
    {num && (
      <p class="eyebrow mb-6">
        <span class="folio text-base" aria-hidden="true">{num}</span>
        {subtitle && <span>{subtitle}</span>}
      </p>
    )}
    {!num && subtitle && <p class="eyebrow mb-6">{subtitle}</p>}
    <h1 class="display max-w-4xl text-4xl leading-[1.15] md:text-6xl">{title}</h1>
    <hr class="rule-pink mt-10" />
  </div>
</section>
