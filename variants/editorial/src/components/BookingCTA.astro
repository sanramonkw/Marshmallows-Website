---
/**
 * Booking call-to-action — editorial rosewood signature button.
 *
 * Links to the booking page, which hosts the native Salonist booking widget
 * (PHASE 2 — see BookingWidget.astro and the PHASE 2 section of CLAUDE.md)
 * with a permanent WhatsApp/phone fallback.
 */
import type { Locale } from '../i18n/ui';
import { useTranslations, pathFor } from '../i18n/utils';

interface Props {
  locale: Locale;
  class?: string;
  ghost?: boolean;
}

const { locale, class: className = '', ghost = false } = Astro.props;
const t = useTranslations(locale);
---

<a
  href={pathFor('booking', locale)}
  class={`btn-editorial ${ghost ? 'btn-editorial--ghost' : ''} ${className}`}
>
  {t('cta.book')}
</a>
