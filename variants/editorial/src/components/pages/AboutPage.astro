---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import type { Locale } from '../../i18n/ui';
import { ui } from '../../i18n/ui';
import { useTranslations, folio } from '../../i18n/utils';
import { aboutIntro, aboutHair, aboutTeam } from '../../data/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const sections = [
  { image: '/images/IMG_2920.jpg', paras: aboutIntro[locale], reverse: false },
  { image: '/images/IMG_4401.jpg', paras: aboutHair[locale], reverse: true },
  { image: '/images/IMG_4585.jpg', paras: aboutTeam[locale], reverse: false },
];
---

<BaseLayout
  locale={locale}
  page="about"
  title={`${t('nav.about')} - ${ui[locale]['site.name']}`}
  description={aboutIntro[locale][0]}
>
  <PageHero title={t('nav.about')} subtitle={t('about.subtitle')} num={folio(1, locale)} />

  {sections.map((s, i) => (
    <section class:list={['border-b border-hairline', { 'border-b-0': i === sections.length - 1 }]}>
      <div class="mx-auto grid max-w-6xl items-start gap-10 px-5 py-16 md:grid-cols-12 lg:gap-16 lg:px-8 lg:py-20">
        <figure class:list={['md:col-span-5', { 'md:order-2': s.reverse }]}>
          <div class="plate overflow-hidden">
            <img src={s.image} alt={t('nav.about')} loading="lazy" class="aspect-[4/5] w-full object-cover" />
          </div>
          <figcaption class="plate-caption mt-3 flex items-baseline gap-3">
            <span class="folio" aria-hidden="true">{folio(i + 1, locale)}</span>
            <span>{t('nav.about')}</span>
          </figcaption>
        </figure>
        <div class:list={['md:col-span-7', { 'md:order-1': s.reverse }]}>
          {s.paras.map((p, j) => (
            <p class:list={['mb-6 leading-loose', j === 0 ? 'text-xl leading-[1.9]' : 'text-ink-soft']}>{p}</p>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="border-t border-hairline">
    <div class="mx-auto max-w-6xl px-5 py-16 text-center lg:px-8">
      <BookingCTA locale={locale} />
    </div>
  </section>
</BaseLayout>
