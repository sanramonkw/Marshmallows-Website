---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PriceList from '../../components/PriceList.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import type { Locale } from '../../i18n/ui';
import { ui } from '../../i18n/ui';
import { useTranslations, folio } from '../../i18n/utils';
import { salonService } from '../../data/services';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<BaseLayout
  locale={locale}
  page="salonService"
  title={`${t('nav.salonService')} - ${ui[locale]['site.name']}`}
  description={ui[locale]['site.description']}
>
  <PageHero title={t('nav.salonService')} subtitle={t('nav.services')} num={folio(2, locale)} />
  <section>
    <div class="mx-auto max-w-6xl px-5 py-16 lg:px-8 lg:py-20">
      <PriceList categories={salonService[locale]} locale={locale} />
      <div class="mt-16 border-t border-hairline pt-12 text-center">
        <BookingCTA locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>
