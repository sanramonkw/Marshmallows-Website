# PHASE 2 — Salonist booking (server-side proxy /api/salonist/*)
# Copy to .env (dev) or set as real environment variables at deploy time.
# NEVER commit real values. Without them the static build still passes and
# the booking widget degrades to the WhatsApp/phone fallback.

# REQUIRED — the salon's Salonist tenant id ("domainId").
# Ask the owner for it, or fetch it once with their Salonist login:
#   curl -X POST https://salonist.io/secureweb/login \
#     -H 'Content-Type: application/json' \
#     -d '{"email":"<owner-email>","password":"<owner-password>"}'
# → response contains "domainId". (See salonist-plugin/ANALYSIS.md §2.)
SALONIST_DOMAIN_ID=

# Optional — Salonist CRM base URL (default https://salonist.io;
# https://salonist.in is the alternate cluster).
#SALONIST_API_BASE=https://salonist.io

# ---------------------------------------------------------------------------
# Forms go-live (milestone 6) — see DEPLOYMENT.md §5 "Forms, captcha & email".
# BOTH values below are PUBLIC (baked into the built HTML). The SECRETS —
# Turnstile SECRET key and SMTP/Resend credentials — live ONLY in the shared
# Cloudflare Worker form relay's env, never in this repo or on this host.
# The relay verifies Turnstile and emails info@marshmallows.co.
# ---------------------------------------------------------------------------

# Cloudflare Turnstile *site* key (public; one widget covers all four domains).
PUBLIC_TURNSTILE_SITE_KEY=

# URL of the shared form-relay Worker endpoint, e.g.
# https://forms.<your-workers-subdomain>.workers.dev/marshmallows
PUBLIC_FORM_ENDPOINT=
