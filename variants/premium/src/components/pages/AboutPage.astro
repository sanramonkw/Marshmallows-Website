---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import BookingCTA from '../../components/BookingCTA.astro';
import type { Locale } from '../../i18n/ui';
import { withBase } from '../../utils/paths';
import { ui } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { aboutIntro, aboutHair, aboutTeam } from '../../data/copy';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);

const sections = [
  { image: withBase('/images/IMG_2920.jpg'), paras: aboutIntro[locale], reverse: false },
  { image: withBase('/images/IMG_4401.jpg'), paras: aboutHair[locale], reverse: true },
  { image: withBase('/images/IMG_4585.jpg'), paras: aboutTeam[locale], reverse: false },
];
---

<BaseLayout
  locale={locale}
  page="about"
  title={`${t('nav.about')} - ${ui[locale]['site.name']}`}
  description={aboutIntro[locale][0]}
>
  <PageHero title={t('nav.about')} subtitle={t('about.subtitle')} />

  {sections.map((s, i) => (
    <section class:list={['py-16 md:py-20', { 'bg-blush-wash/50': i % 2 === 1 }]}>
      <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 md:grid-cols-12 lg:px-6">
        <div class:list={['relative md:col-span-5', { 'md:order-2': s.reverse }]} data-reveal>
          <div
            class:list={[
              'absolute -inset-4 rounded-[2.5rem]',
              i % 2 === 1 ? 'bg-cream' : 'bg-pink-pale/40',
            ]}
            aria-hidden="true"
          ></div>
          <img
            src={s.image}
            alt={t('nav.about')}
            loading="lazy"
            class="relative w-full rounded-[2rem] border-4 border-cream shadow-plush"
          />
        </div>
        <div class:list={['md:col-span-7', { 'md:order-1': s.reverse }]} data-reveal>
          <div class="flourish flourish--start mb-6"><span class="flourish-gem"></span></div>
          {s.paras.map((p) => <p class="mb-5 text-lg leading-loose">{p}</p>)}
        </div>
      </div>
    </section>
  ))}

  <section class="pb-20 pt-4 text-center">
    <BookingCTA locale={locale} />
  </section>
</BaseLayout>
